{
  "name": "dash-harness-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend build for the local Orchestration Console.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check web/src vite.config.ts",
    "check:file-sizes": "node scripts/check-file-sizes.mjs",
    "check:px-text": "node scripts/check-px-text.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:file-sizes && npm run check:px-text && npm run check:design-tokens",
    "test:unit": "node --experimental-strip-types --test \"web/src/**/*.test.mjs\"",
    "test:e2e:smoke": "playwright test --project=smoke",
    "bench": "ORCH_BENCHMARK_TESTS=1 .venv/bin/python -m unittest discover -s tests -p test_harness_latency.py",
    "format": "biome format --write web/src vite.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.168.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "virtua": "0.49.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/router-plugin": "^1.167.12",
    "@tanstack/virtual-file-routes": "^1.161.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  }
}
