{
  "schema_version": 1,
  "components": [
    {
      "name": "orchestration-console",
      "type": "git",
      "source": "https://github.com/maslennikov-ig/codex-orchestration-console.git",
      "target": "${HARNESS_HOME}/components/orchestration-console",
      "install": [["./scripts/install.sh"], ["./scripts/install_claude_plugin.sh"]],
      "doctor": [
        {"type": "path_exists", "path": "${HARNESS_HOME}/components/orchestration-console/scripts/start_console.sh"},
        {"type": "path_exists", "path": "${CLAUDE_HOME}/skills/orchestration-bridge/.claude-plugin/plugin.json"}
      ]
    },
    {
      "name": "codex-public-skills",
      "type": "copy_tree",
      "source": "${HARNESS_REPO}/assets/codex/skills",
      "target": "${AGENTS_HOME}/skills",
      "doctor": [
        {"type": "path_exists", "path": "${AGENTS_HOME}/skills/harness-bootstrap/SKILL.md"}
      ]
    },
    {
      "name": "codex-public-agents",
      "type": "copy_tree",
      "source": "${HARNESS_REPO}/assets/codex/agents",
      "target": "${CODEX_HOME}/agents",
      "doctor": [
        {"type": "path_exists", "path": "${CODEX_HOME}/agents/harness-tooling-engineer.toml"}
      ]
    },
    {
      "name": "mcp-public-templates",
      "type": "copy_tree",
      "source": "${HARNESS_REPO}/assets/mcp/templates",
      "target": "${HARNESS_HOME}/mcp/templates",
      "doctor": [
        {"type": "path_exists", "path": "${HARNESS_HOME}/mcp/templates/codex.mcp.json"}
      ]
    },
    {
      "name": "node",
      "type": "binary",
      "target": "node",
      "install": [["sh", "-lc", "if command -v brew >/dev/null 2>&1; then brew install node; elif command -v apt-get >/dev/null 2>&1; then sudo apt-get update && sudo apt-get install -y nodejs npm; else echo 'Install Node.js >= 18 manually for MCP npx servers' >&2; exit 1; fi"]],
      "doctor": [{"type": "command", "command": ["node", "--version"]}]
    },
    {
      "name": "npx",
      "type": "binary",
      "target": "npx",
      "install": [["sh", "-lc", "if command -v npm >/dev/null 2>&1; then npm install -g npm; elif command -v brew >/dev/null 2>&1; then brew install node; elif command -v apt-get >/dev/null 2>&1; then sudo apt-get update && sudo apt-get install -y nodejs npm; else echo 'Install npm/npx manually for MCP servers' >&2; exit 1; fi"]],
      "doctor": [{"type": "command", "command": ["npx", "--version"]}]
    },
    {
      "name": "context",
      "type": "binary",
      "target": "context",
      "install": [["sh", "-lc", "npm install -g @neuledge/context"]],
      "doctor": [{"type": "command", "command": ["context", "--version"]}]
    },
    {
      "name": "bd",
      "type": "binary",
      "target": "bd",
      "install": [["sh", "-lc", "curl -fsSL https://raw.githubusercontent.com/gastownhall/beads/main/scripts/install.sh | bash"]],
      "doctor": [{"type": "command", "command": ["bd", "--version"]}]
    },
    {
      "name": "age",
      "type": "binary",
      "target": "age",
      "install": [["sh", "-lc", "if command -v brew >/dev/null 2>&1; then brew install age; elif command -v apt-get >/dev/null 2>&1; then sudo apt-get update && sudo apt-get install -y age; else echo 'Install age manually for encrypted private overlay workflows' >&2; exit 1; fi"]],
      "doctor": [{"type": "command", "command": ["age", "--version"]}]
    }
  ]
}
